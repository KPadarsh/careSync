# ==============================================================================
# CARESYNC — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and provide your actual values.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/caresync)
MONGODB_URI=

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Secret key used for signing & verifying HTTP-only session tokens (HMAC SHA-256)
SESSION_SECRET=

# Internal shared secret for authorizing trusted server-to-server webhook dispatches
INTERNAL_REALTIME_SECRET=

# ------------------------------------------------------------------------------
# 3. APPLICATION & API URLS
# ------------------------------------------------------------------------------
# Base URL of the CareSync Next.js web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client-facing URL for the Socket.IO realtime server (accessible from browser)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Internal server-to-server URL used by Next.js API routes to dispatch realtime events
INTERNAL_SOCKET_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 4. REALTIME SOCKET.IO SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the standalone Socket.IO realtime server
SOCKET_PORT=3001
REALTIME_PORT=3001

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
